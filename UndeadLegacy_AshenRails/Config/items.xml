<configs>
	<append xpath="/items">
		<item name="ad2RailLocoPlaceable">
			<property name="CreativeMode" value="Player"/>
			<property name="Tags" value="T1,vehicle,vengine,vfuel,vstorage,vlight,vplow,vseat,vrailcruise,vrailtimetable,canHaveCosmetic"/>
			<property name="DescriptionKey" value="ad2RailLocoPlaceableDesc"/>
			<property name="HoldType" value="7"/>
			<property name="HoldingItemHidden" value="true"/>
			<property name="Meshfile" value="#@modfolder:Resources/AD2Railroads.unity3d?ad2RailLocoP.prefab"/>
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
			<property name="Material" value="Mmetal"/>
			<property name="Weight" value="0"/>
			<property name="Stacknumber" value="1"/>
			<property name="EconomicValue" value="8000"/>
			<property name="SellableToTrader" value="true"/>
			<property name="Group" value="Science,TCScience"/>
			<property name="SoundPickup" value="minibike_grab"/>
			<property name="SoundPlace" value="minibike_place"/>
			<property class="Action1">
				<property name="Class" value="SpawnVehicle"/>
				<property name="Vehicle" value="ad2RailLoco"/>
				<property name="VehicleSize" value="1.7, 2.1, 3.9"/>
			</property>
			<effect_group name="ad2RailLocoPlaceable" tiered="false">
				<passive_effect name="ModSlots" operation="base_set" value="6"/>
				<passive_effect name="DegradationMax" operation="base_set" value="3000"/>
			</effect_group>
		</item>
		<item name="ad2RailWagonLore">
			<property name="CreativeMode" value="Player"/>
			<property name="DescriptionKey" value="ad2RailWagonLoreDesc"/>
			<property name="CustomIcon" value="ad2RailModLoreWagon"/>
			<property name="HoldType" value="45"/>
			<property name="Meshfile" value="@:Other/Items/Misc/sackPrefab.prefab"/>
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
			<property name="Material" value="Mmetal"/>
			<property name="Stacknumber" value="1"/>
			<property name="EconomicValue" value="1500"/>
			<property name="Group" value="Science,TCScience"/>
			<property name="RailWagonModel" value="Wagon"/>
			<property name="RailWagonAxleOffset" value="0.393"/>
			<property name="RailWagonWheels" value="WagonWheel0,WagonWheel1,WagonWheel2,WagonWheel3"/>
			<property name="RailWagonWheelRadius" value="0.233"/>
			<property name="RailWagonCoupler" value="WagonCoupler"/>
			<property name="RailWagonCouplerFront" value="0,0.319,1.133"/>
			<property name="StorageRows" value="15"/>
		</item>
		<item name="ad2RailWagonFlatcar">
			<property name="CreativeMode" value="Player"/>
			<property name="DescriptionKey" value="ad2RailWagonFlatcarDesc"/>
			<property name="CustomIcon" value="ad2RailWagonFlatcar"/>
			<property name="HoldType" value="45"/>
			<property name="Meshfile" value="@:Other/Items/Misc/sackPrefab.prefab"/>
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
			<property name="Material" value="Mmetal"/>
			<property name="Stacknumber" value="1"/>
			<property name="EconomicValue" value="2500"/>
			<property name="Group" value="Science,TCScience"/>
			<property name="RailWagonModel" value="#@modfolder:Resources/AD2Railroads.unity3d?ad2RailFlatcar.prefab"/>
			<property name="RailWagonAxleOffset" value="1.3"/>
			<property name="RailWagonWheels" value="Wheelset0,Wheelset1,Wheelset2,Wheelset3"/>
			<property name="RailWagonWheelRadius" value="0.231"/>
			<property name="RailWagonCouplerFront" value="0,0.563,2.553"/>
			<property name="RailWagonCouplerHeads" value="CouplerFront,CouplerRear"/>
			<property name="RailWagonCouplerShanks" value="ShankFront,ShankRear"/>
			<property name="RailWagonCouplerHeadLength" value="0.518"/>
			<property name="RailWagonCouplerOverlap" value="0.16"/>
			<property name="RailWagonGap" value="0.5"/>
			<property name="RailWagonMax" value="10"/>
			<property name="RailWagonDeck" value="0.814"/>
			<property name="RailWagonBuildSize" value="2,3,4"/>
		</item>
		<item name="ad2RailRepairKitRunningGear">
			<property name="CreativeMode" value="Player"/>
			<property name="DescriptionKey" value="ad2RailRepairKitRunningGearDesc"/>
			<property name="HoldType" value="45"/>
			<property name="Meshfile" value="@:Other/Items/Misc/sackPrefab.prefab"/>
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
			<property name="Material" value="Msteel"/>
			<property name="Stacknumber" value="10"/>
			<property name="EconomicValue" value="2000"/>
			<property name="Group" value="Resources"/>
			<property name="SoundPickup" value="repairkits_grab"/>
			<property name="SoundPlace" value="repairkits_place"/>
		</item>
		<item name="ad2RailRepairKitEngine">
			<property name="Extends" value="ad2RailRepairKitRunningGear"/>
			<property name="CreativeMode" value="Player"/>
			<property name="DescriptionKey" value="ad2RailRepairKitEngineDesc"/>
		</item>
	</append>
	<csv xpath="/items/item[@name='meleeToolRepairT1ClawHammer']/property[@class='Action1']/property[@name='Allowed_upgrade_items']/@value" delim="," op="add">ad2RailRepairKitRunningGear,ad2RailRepairKitEngine</csv>
	<csv xpath="/items/item[@name='meleeToolRepairT3Nailgun']/property[@class='Action1']/property[@name='Allowed_upgrade_items']/@value" delim="," op="add">ad2RailRepairKitRunningGear,ad2RailRepairKitEngine</csv>
	<append xpath="/items/item[@name='ad2RailLocoPlaceable']">
		<property name="RepairTools" value="resourceRepairKit"/>
		<property name="CarryWeight" value="20" param1="3000"/>
	</append>
	<append xpath="/items/item[@name='ad2RailWagonLore' or @name='ad2RailWagonFlatcar']">
		<property name="CarryWeight" value="10"/>
	</append>
	<append xpath="/items/item[@name='ad2RailWagonLore']">
		<property name="RailCargoCapacity" value="6000"/>
	</append>
	<append xpath="/items/item[@name='ad2RailRepairKitRunningGear' or @name='ad2RailRepairKitEngine']">
		<property name="CarryWeight" value="0.25"/>
	</append>
	<append xpath="/items/item[@name='ad2RailLocoPlaceable']/effect_group[@name='ad2RailLocoPlaceable']">
		<passive_effect name="VehicleCargoCapacity" operation="base_set" value="6000"/>
	</append>
</configs>
