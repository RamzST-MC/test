<configs>
	<append xpath="/vehicles">
		<vehicle name="ad2RailLoco">
			<property name="cameraDistance" value="4.5, 6.5"/>
			<property name="cameraTurnRate" value=".2, .35"/>
			<property name="upAngleMax" value="70"/>
			<property name="upForce" value="0"/>
			<property name="velocityMax_turbo" value="13.5, 13.5, 19, 19"/>
			<property name="railAccel" value="4"/>
			<property name="railBrake" value="6"/>
			<property name="railCoastDrag" value="0.3"/>
			<property name="railNoDriverBrake" value="10"/>
			<property name="railLookAhead" value="2.45"/>
			<property name="railUphillSpeed" value="0.7"/>
			<property name="railAxleOffset" value="1"/>
			<property name="railWheels" value="F_Wheels,R_Wheels"/>
			<property name="railWheelRadius" value="0.271"/>
			<property name="railCouplerLoco" value="0,0.5,-1.898"/>
			<property name="railWagonGap" value="0.486"/>
			<property name="hornSound" value="ad2RailLocoHorn"/>
			<property name="recipeName" value="ad2RailLocoPlaceable"/>

			<property class="chassis">
				<property name="class" value="Chassis"/>
				<property name="paint" value="M"/>
			</property>

			<property class="engine">
				<property name="class" value="Engine"/>
				<property name="fuelKmPerL" value=".15"/>
				<property name="foodDrain" value=".002,.00811"/>
				<property name="gear1" value="
								500,2500, -1400,800,0, 700,2200,900,
								,
								,
								0, .5, .35, .35, -9, .02, .05, ad2RailLocoIdle,
								-.5, -.2, .7, 1, -.49, 9, .01, ad2RailLocoRoll
								"/>
				<property name="gear2" value="
								500,2500, -2000,1000,2000, 600,2200,800,
								,
								,
								-.15, .1, .85, 1, -9, 9, .1, ad2RailLocoRoll
								"/>
				<property name="gear3" value="
								500,2500, -2000,1000,2000, 500,9999,9999,
								,
								,
								0, .25, 1, 1, -9, 9, .1, ad2RailLocoRoll
								"/>
				<property name="sound_start" value="ad2RailLocoAirStart"/>
				<property name="sound_shut_off" value="ad2RailLocoAirStop"/>
				<property name="sound_no_fuel_shut_off" value="ad2RailLocoAirStop"/>
			</property>

			<property class="fuelTank">
				<property name="class" value="FuelTank"/>
				<property name="capacity" value="150"/>
			</property>

			<property class="seat0">
				<property name="class" value="Seat"/>
				<property name="pose" value="42"/>
				<property name="position" value=".35, -.15, .2"/>
				<property name="rotation" value="0, 0, 0"/>
				<property name="exit" value="1.4,0,0 ~ -1.4,0,0 ~ 0,0,-2.5 ~ 0,0,2.5 ~ 0,2.3,0"/>
			</property>

			<property class="seat1">
				<property name="class" value="Seat"/>
				<property name="pose" value="42"/>
				<property name="position" value="-.35, -.15, .2"/>
				<property name="rotation" value="0, 0, 0"/>
				<property name="exit" value="-1.4,0,0 ~ 1.4,0,0 ~ 0,0,-2.5 ~ 0,0,2.5 ~ 0,2.3,0"/>
				<property name="mod" value="seat"/>
			</property>

			<property class="storage">
				<property name="class" value="Storage"/>
			</property>

			<property class="headlight">
				<property name="class" value="Headlight"/>
				<property name="bright" value=".75"/>
				<property name="transform" value="M/HeadLights/Lights"/>
				<property name="matT" value="M/HeadLights"/>
				<property name="matEmissive" value="FFE9B0"/>
				<property name="mod" value="light"/>
				<property name="modT" value="M/LightBar"/>
				<property name="modOnT" value="M/LightBar/LightBar/Lights"/>
				<property name="modMatEmissive" value="909090"/>
			</property>

			<property class="plow">
				<property name="class" value="VehiclePart"/>
				<property name="mod" value="plow"/>
				<property name="modT" value="M/Plow"/>
				<property name="modRBT" value="Plow"/>
			</property>

			<property class="railClone0">
				<property name="source" value="@:Entities/Vehicles/VTruck4x4/VTruck4x4P.prefab"/>
				<property name="path" value="GameObject/M/Plow"/>
				<property name="target" value="M/Plow"/>
				<property name="position" value="0,0.06,0.67"/>
				<property name="scale" value="0.5"/>
				<property name="keepLod" value="_LOD0"/>
			</property>

			<property class="railClone1">
				<property name="source" value="@:Entities/Vehicles/VTruck4x4/VTruck4x4P.prefab"/>
				<property name="path" value="GameObject/M/LightBar"/>
				<property name="target" value="M/LightBar"/>
				<property name="position" value="0,0.204,0.09"/>
				<property name="scale" value="0.8"/>
				<property name="keepLod" value="_LOD0"/>
			</property>

			<property class="railClone2">
				<property name="source" value="@:Entities/Vehicles/VTruck4x4/VTruck4x4P.prefab"/>
				<property name="path" value="GameObject/Particles/p_on"/>
				<property name="target" value="Particles"/>
				<property name="position" value="-0.245,2.06,-1.099"/>
				<property name="zeroChildren" value="true"/>
				<property name="emissionScale" value="3"/>
				<property name="sizeScale" value="1.5"/>
				<property name="lifetimeScale" value="1.5"/>
				<property name="active" value="false"/>
			</property>

			<property class="railClone3">
				<property name="source" value="@:Entities/Vehicles/VTruck4x4/VTruck4x4P.prefab"/>
				<property name="path" value="GameObject/Particles/p_damaged"/>
				<property name="target" value="Particles"/>
				<property name="position" value="0,1.6,-0.9"/>
				<property name="active" value="false"/>
			</property>

			<property class="railClone4">
				<property name="source" value="@:Entities/Vehicles/VTruck4x4/VTruck4x4P.prefab"/>
				<property name="path" value="GameObject/Particles/p_broken"/>
				<property name="target" value="Particles"/>
				<property name="position" value="0,1.3,-0.9"/>
				<property name="active" value="false"/>
			</property>
		</vehicle>
	</append>
	<append xpath="/vehicles/vehicle[@name='ad2RailLoco']/property[@class='seat0' or @class='seat1']">
		<property name="railFpvEyeOffset" value="0, 0.15, 0"/>
	</append>
</configs>
